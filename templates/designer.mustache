                    }
                ]
            }
        ],
        "picture": true,
        "pictureallowed": true,
        "haspicture": true,
        "hasdesign": true,
        "hascredits": true,
        "credits": [
            {
                "name": "Suit and tie",
                "title": "Suit & Tie Guy",
                "credit": "by Ian MacGillivray, CC BY 3.0",
                "source": "https://poly.pizza/m/cgdjE3cst7f"
            }
        ],
        "presets": [
            {
                "id": "explorer",
                "name": "Explorer",
                "json": "{\"hair\":\"short\",\"hat\":\"sunhat\"}"
            }
        ],
        "haspresets": true,
        "looksicon": "https://example.org/theme/image.php/boost/local_vravatar/1/tabs/looks"
    }
}}
<div class="local-vravatar" data-region="local-vravatar-designer">
    <div class="local-vravatar-intro">
        <p class="mb-1">{{#str}}intro, local_vravatar{{/str}}</p>
        <details class="small text-muted">
            <summary>{{#str}}whosees_title, local_vravatar{{/str}}</summary>
            <p class="mb-0">{{#str}}whosees, local_vravatar{{/str}}</p>
        </details>
        {{^hasdesign}}
            <p class="small text-muted mb-0" data-region="nodesign">{{#str}}nodesign, local_vravatar{{/str}}</p>
        {{/hasdesign}}
    </div>

    <div class="local-vravatar-layout">
        <div class="local-vravatar-preview" data-region="previewpane">
            <h3 class="visually-hidden">{{#str}}preview, local_vravatar{{/str}}</h3>
            <div class="local-vravatar-stage" id="local-vravatar-stage" data-region="stage">
                <canvas class="local-vravatar-canvas" data-region="canvas" tabindex="0" role="img"
                    aria-label="{{#str}}previewlabel, local_vravatar{{/str}}"
                    aria-describedby="local-vravatar-previewhelp" hidden></canvas>
                <p class="local-vravatar-fallback" data-region="fallback">{{#str}}previewunavailable, local_vravatar{{/str}}</p>
            </div>
            <p class="small text-muted local-vravatar-previewhelp" id="local-vravatar-previewhelp" data-region="previewhelp" hidden>
                {{#str}}previewhelp, local_vravatar{{/str}}
            </p>
            <div class="local-vravatar-previewbuttons">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-action="surprise" data-region="surprisetool"
                    title="{{#str}}surprise, local_vravatar{{/str}}" hidden>
                    <span class="local-vravatar-dice-small" aria-hidden="true"></span>
                    <span class="local-vravatar-btntext">{{#str}}surprise, local_vravatar{{/str}}</span>
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" data-action="undo"
                    title="{{#str}}undo, local_vravatar{{/str}}" disabled hidden>
                    {{#pix}}e/undo, core{{/pix}}<span class="local-vravatar-btntext">{{#str}}undo, local_vravatar{{/str}}</span>
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" data-action="redo"
                    title="{{#str}}redo, local_vravatar{{/str}}" disabled hidden>
                    {{#pix}}e/redo, core{{/pix}}<span class="local-vravatar-btntext">{{#str}}redo, local_vravatar{{/str}}</span>
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" data-action="zoom" aria-controls="local-vravatar-stage"
                    title="{{#str}}showwhole, local_vravatar{{/str}}" aria-pressed="false" hidden>
                    {{#pix}}e/fullscreen, core{{/pix}}<span class="local-vravatar-btntext">{{#str}}showwhole, local_vravatar{{/str}}</span>
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" data-action="camera" aria-pressed="false" hidden>
                    {{#pix}}e/insert_edit_video, core{{/pix}}<span class="local-vravatar-btntext">{{#str}}camerapreview, local_vravatar{{/str}}</span>
                </button>
                <button type="button" class="btn btn-link btn-sm local-vravatar-reset" data-action="reset" hidden>
                    {{#str}}reset, local_vravatar{{/str}}
                </button>
            </div>
        </div>

        <div class="local-vravatar-choices">
            <form method="post" action="{{actionurl}}" data-region="form">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="action" value="save">
                <div class="local-vravatar-tablist" role="tablist" aria-label="{{#str}}tabs, local_vravatar{{/str}}"
                    data-region="tablist" hidden>
                    {{#haspresets}}
                        <button type="button" class="local-vravatar-tab" role="tab" id="local-vravatar-section-looks-tab"
                            aria-controls="local-vravatar-section-looks" aria-selected="true" tabindex="0" data-frame="whole">
                            <span class="local-vravatar-tabicon" style="mask-image: url({{looksicon}}); -webkit-mask-image: url({{looksicon}});"
                                aria-hidden="true"></span>
                            <span class="local-vravatar-tablabel">{{#str}}tab_looks, local_vravatar{{/str}}</span>
                        </button>
                    {{/haspresets}}
                    {{#sections}}
                        <button type="button" class="local-vravatar-tab" role="tab" id="{{tabid}}" aria-controls="{{id}}"
                            aria-selected="false" tabindex="-1" data-frame="{{frame}}">
                            <span class="local-vravatar-tabicon" style="mask-image: url({{icon}}); -webkit-mask-image: url({{icon}});"
                                aria-hidden="true"></span>
                            <span class="local-vravatar-tablabel">{{tablabel}}</span>
                        </button>
                    {{/sections}}
                </div>
                {{#haspresets}}
                    <section class="local-vravatar-section local-vravatar-looks" id="local-vravatar-section-looks"
                        aria-labelledby="local-vravatar-looks-heading" data-region="looks" hidden>
                        <h3 class="h5" id="local-vravatar-looks-heading">{{#str}}looks_heading, local_vravatar{{/str}}</h3>
                        <p class="small text-muted" id="local-vravatar-presets-help">{{#str}}presets_help, local_vravatar{{/str}}</p>
                        <div class="local-vravatar-lookgrid">
                            {{#presets}}
                                <button type="button" class="local-vravatar-look" data-action="preset" data-preset="{{id}}"
                                    data-design="{{json}}" aria-describedby="local-vravatar-presets-help">
                                    <span class="local-vravatar-pic" data-region="presetpic" aria-hidden="true"></span>
                                    <span class="local-vravatar-tile-name">{{name}}</span>
                                </button>
                            {{/presets}}
                            <button type="button" class="local-vravatar-look local-vravatar-look-surprise" data-action="surprise">
                                <span class="local-vravatar-pic" aria-hidden="true"><span class="local-vravatar-dice"></span></span>
                                <span class="local-vravatar-tile-name">{{#str}}surprise, local_vravatar{{/str}}</span>
                            </button>
                        </div>
                    </section>
                {{/haspresets}}
                {{#sections}}
                    <section class="local-vravatar-section" id="{{id}}" aria-labelledby="{{id}}-heading" data-region="panel"
                        data-tab="{{tabid}}">
                        <h3 class="h5 local-vravatar-section-heading" id="{{id}}-heading">{{heading}}</h3>
                        {{#ishands}}
                            <p class="form-text text-muted">{{#str}}hands_help, local_vravatar{{/str}}</p>
                        {{/ishands}}
                        {{#items}}
                            {{#radio}}
                                <fieldset class="local-vravatar-group" id="{{id}}">
                                    <legend class="visually-hidden">{{legend}}</legend>
                                    <div class="local-vravatar-grouphead" aria-hidden="true">
                                        {{legend}}{{#isswatch}}<span class="local-vravatar-chosen" data-region="chosen"></span>{{/isswatch}}
                                    </div>
                                    <div class="local-vravatar-tiles{{#isswatch}} local-vravatar-swatchgrid{{/isswatch}}">
                                        {{#options}}
                                            <div class="local-vravatar-tile{{#isswatch}} local-vravatar-tile-swatch{{/isswatch}}">
                                                <input class="local-vravatar-tile-input" type="radio" name="{{name}}" value="{{value}}" id="{{id}}"
                                                    {{#model}}data-model="{{model}}"{{/model}} {{#checked}}checked{{/checked}}>
                                                <label class="local-vravatar-tile-label" for="{{id}}"{{#isswatch}} title="{{label}}"{{/isswatch}}>
                                                    {{#isswatch}}
                                                        <span class="local-vravatar-swatch{{#follows}} local-vravatar-swatch-follows{{/follows}}"
                                                            data-swatch="{{value}}" data-palette="{{palette}}"
                                                            {{#swatch}}style="background-color: {{swatch}};"{{/swatch}} aria-hidden="true"></span>
                                                    {{/isswatch}}
                                                    {{^isswatch}}
                                                        <span class="local-vravatar-pic" aria-hidden="true"
                                                            {{#render}}data-render="{{render}}" data-key="{{name}}" data-value="{{value}}"{{/render}}>
                                                            {{#pic}}<img src="{{pic}}" alt="" width="96" height="96" loading="lazy">{{/pic}}
                                                            {{#mask}}<span class="local-vravatar-handpic" data-region="handpic"
                                                                style="mask-image: url({{mask}}); -webkit-mask-image: url({{mask}});"></span>{{/mask}}
                                                        </span>
                                                    {{/isswatch}}
                                                    <span class="local-vravatar-tile-name">{{label}}</span>
                                                    {{^isswatch}}{{#credit}}<span class="local-vravatar-credit">{{credit}}</span>{{/credit}}{{/isswatch}}
                                                </label>
                                            </div>
                                        {{/options}}
                                    </div>
                                </fieldset>
                            {{/radio}}
                            {{#costume}}
                                <fieldset class="local-vravatar-group local-vravatar-costumes" id="{{id}}"
                                    aria-describedby="local-vravatar-outfit-help">
                                    <legend class="h6">{{legend}}</legend>
                                    <p class="form-text text-muted" id="local-vravatar-outfit-help">{{#str}}outfit_help, local_vravatar{{/str}}</p>
                                    {{#none}}
                                        <div class="form-check local-vravatar-option">
                                            <input class="form-check-input" type="radio" name="{{name}}" value="{{value}}" id="{{id}}"
                                                {{#checked}}checked{{/checked}}>
                                            <label class="form-check-label" for="{{id}}">{{label}}</label>
                                        </div>
                                    {{/none}}
                                    {{#categories}}
                                        <fieldset class="local-vravatar-costumecategory" id="{{id}}">
                                            <legend class="local-vravatar-costumelegend">{{legend}}</legend>
                                            <div class="local-vravatar-costumegrid">
                                                {{#options}}
                                                    <div class="local-vravatar-costume">
                                                        <input class="local-vravatar-costume-input" type="radio" name="outfit"
                                                            value="{{value}}" id="{{id}}" data-model="{{model}}" data-kind="{{kind}}"
                                                            {{#checked}}checked{{/checked}}>
                                                        <label class="local-vravatar-costume-label" for="{{id}}">
                                                            <img class="local-vravatar-costume-thumb" src="{{thumb}}" alt="" width="96" height="96"
                                                                loading="lazy">
                                                            <span class="local-vravatar-costume-name">{{label}}</span>
                                                            {{#credit}}<span class="local-vravatar-credit">{{credit}}</span>{{/credit}}
                                                        </label>
                                                    </div>
                                                {{/options}}
                                            </div>
                                        </fieldset>
                                    {{/categories}}
                                </fieldset>
                                {{#hascredits}}
                                    <details class="local-vravatar-credits">
                                        <summary>{{#str}}costumecredits, local_vravatar{{/str}}</summary>
                                        <ul class="small">
                                            {{#credits}}
                                                <li>{{name}}: <a href="{{source}}">{{title}}</a> {{credit}}</li>
                                            {{/credits}}
                                        </ul>
                                    </details>
                                {{/hascredits}}
                            {{/costume}}
                            {{#check}}
                                <fieldset class="local-vravatar-group" id="{{groupid}}">
                                    <legend class="visually-hidden">{{legend}}</legend>
                                    <div class="local-vravatar-grouphead" aria-hidden="true">{{legend}}</div>
                                    <div class="local-vravatar-tiles">
                                        <div class="local-vravatar-tile">
                                            <input class="local-vravatar-tile-input" type="checkbox" name="{{name}}" value="1" id="{{id}}"
                                                {{#checked}}checked{{/checked}}>
                                            <label class="local-vravatar-tile-label" for="{{id}}">
                                                <span class="local-vravatar-pic" aria-hidden="true"
                                                    {{#render}}data-render="{{render}}" data-key="{{name}}" data-value="1"{{/render}}></span>
                                                <span class="local-vravatar-tile-name">{{label}}</span>
                                            </label>
                                        </div>
                                    </div>
                                </fieldset>
                            {{/check}}
                        {{/items}}
                        {{#isextras}}
                            <fieldset class="local-vravatar-group" id="local-vravatar-group-picture">
                                <legend class="h6">{{#str}}picturebadge, local_vravatar{{/str}}</legend>
                                {{#pictureallowed}}
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="picture" value="1" id="local-vravatar-picture"
                                            aria-describedby="local-vravatar-picture-help" {{#picture}}checked{{/picture}}>
                                        <label class="form-check-label" for="local-vravatar-picture">{{#str}}picture, local_vravatar{{/str}}</label>
                                        <div class="form-text text-muted" id="local-vravatar-picture-help">
                                            {{#str}}picture_help, local_vravatar{{/str}}
                                            {{^haspicture}}{{#str}}picturenone, local_vravatar{{/str}}{{/haspicture}}
                                        </div>
                                    </div>
                                {{/pictureallowed}}
                                {{^pictureallowed}}
                                    <p class="text-muted mb-0">{{#str}}picturedisabled, local_vravatar{{/str}}</p>
                                {{/pictureallowed}}
                            </fieldset>
                        {{/isextras}}
                    </section>
                {{/sections}}

                <div class="local-vravatar-savebar" data-region="savebar">
                    <button type="submit" class="btn btn-primary" data-action="save">{{#str}}save, local_vravatar{{/str}}</button>
                    <span class="local-vravatar-dirty" data-region="dirty" hidden>{{#str}}unsaved, local_vravatar{{/str}}</span>
                    <p class="local-vravatar-status" data-region="status" role="status" aria-live="polite"></p>
                </div>
            </form>

            <form method="post" action="{{actionurl}}" data-region="removeform"{{^hasdesign}} hidden{{/hasdesign}}>
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="action" value="remove">
                <button type="submit" class="btn btn-link px-0">{{#str}}remove, local_vravatar{{/str}}</button>
            </form>
        </div>
    </div>
</div>
