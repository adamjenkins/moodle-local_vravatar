<div class="local-vravatar" data-region="local-vravatar-designer">
    <div class="local-vravatar-intro">
        <p class="mb-1">{{#str}}introshort, local_vravatar{{/str}}</p>
        <details class="small text-muted">
            <summary>{{#str}}whosees_title, local_vravatar{{/str}}</summary>
            <p class="mb-1">{{#str}}intro, local_vravatar{{/str}}</p>
            <p class="mb-0">{{#str}}whosees, local_vravatar{{/str}}</p>
        </details>
        {{^hasdesign}}
            <p class="small text-muted mb-0" data-region="nodesign">{{#str}}nodesign, local_vravatar{{/str}}</p>
        {{/hasdesign}}
    </div>

    <div class="local-vravatar-layout">
        <div class="local-vravatar-preview" data-region="previewpane">
            <h3 class="visually-hidden">{{#str}}preview, local_vravatar{{/str}}</h3>
            <div class="local-vravatar-stage" id="local-vravatar-stage" data-region="stage">
                <canvas class="local-vravatar-canvas" data-region="canvas" tabindex="0" role="img"
                    aria-label="{{#str}}previewlabel, local_vravatar{{/str}}"
                    aria-describedby="local-vravatar-previewhelp" hidden></canvas>
                <p class="local-vravatar-fallback" data-region="fallback">{{#str}}previewunavailable, local_vravatar{{/str}}</p>
                <div class="local-vravatar-coach local-vravatar-glass" data-region="coach" hidden>
                    <p class="local-vravatar-coachtext" data-region="coachtext" role="status" aria-live="polite"></p>
                    <button type="button" class="local-vravatar-gbtn local-vravatar-gbtn-close" data-action="coachclose"
                        title="{{#str}}coach_close, local_vravatar{{/str}}">
                        <svg class="local-vravatar-icon" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg><span class="visually-hidden">{{#str}}coach_close, local_vravatar{{/str}}</span>
                    </button>
                    <span hidden data-hint="look" data-glow="look">{{#str}}coach_look, local_vravatar{{/str}}</span>
                    <span hidden data-hint="part" data-glow="parttab">{{#str}}coach_part, local_vravatar{{/str}}</span>
                    <span hidden data-hint="save" data-glow="save">{{#str}}coach_save, local_vravatar{{/str}}</span>
                    <span hidden data-hint="done" data-glow="">{{#str}}coach_done, local_vravatar{{/str}}</span>
                </div>
                <div class="local-vravatar-tools local-vravatar-glass" role="group" aria-label="{{#str}}tools, local_vravatar{{/str}}"
                    data-region="tools" hidden>
                    <button type="button" class="local-vravatar-gbtn" data-action="surprise" title="{{#str}}surprise, local_vravatar{{/str}}" data-region="surprisetool" hidden>
                        <svg class="local-vravatar-icon" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 8h.01M16 8h.01M12 12h.01M8 16h.01M16 16h.01"/></svg><span class="visually-hidden" data-region="surpriselabel">{{#str}}surprise, local_vravatar{{/str}}</span>
                    </button>
                    <button type="button" class="local-vravatar-gbtn" data-action="undo" title="{{#str}}undo, local_vravatar{{/str}}" disabled hidden>
                        <svg class="local-vravatar-icon" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 14L4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-3"/></svg><span class="visually-hidden" data-region="undolabel">{{#str}}undo, local_vravatar{{/str}}</span>
                    </button>
                    <button type="button" class="local-vravatar-gbtn" data-action="redo" title="{{#str}}redo, local_vravatar{{/str}}" disabled hidden>
                        <svg class="local-vravatar-icon" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14l5-5-5-5"/><path d="M20 9H9a5 5 0 0 0 0 10h3"/></svg><span class="visually-hidden" data-region="redolabel">{{#str}}redo, local_vravatar{{/str}}</span>
                    </button>
                    <button type="button" class="local-vravatar-gbtn" data-action="zoom" title="{{#str}}showwhole, local_vravatar{{/str}}" aria-controls="local-vravatar-stage" aria-pressed="false" hidden>
                        <svg class="local-vravatar-icon" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3M16 21h3a2 2 0 0 0 2-2v-3"/></svg><span class="visually-hidden" data-region="zoomlabel">{{#str}}showwhole, local_vravatar{{/str}}</span>
                    </button>
                    <button type="button" class="local-vravatar-gbtn" data-action="demowalk" title="{{#str}}demowalk, local_vravatar{{/str}}" hidden>
                        <svg class="local-vravatar-icon" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="13" cy="4" r="2"/><path d="M8 22l3-7 3 3v4M10 13l1-5 4 2 2 3M7 11l4-3"/></svg><span class="visually-hidden">{{#str}}demowalk, local_vravatar{{/str}}</span>
                    </button>
                    <button type="button" class="local-vravatar-gbtn" data-action="demowave" title="{{#str}}demowave, local_vravatar{{/str}}" hidden>
                        <svg class="local-vravatar-icon" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 11V6a2 2 0 0 0-4 0v5M14 10V4a2 2 0 0 0-4 0v6M10 10.5V6a2 2 0 0 0-4 0v8a8 8 0 0 0 16 0v-2a2 2 0 0 0-4 0"/></svg><span class="visually-hidden">{{#str}}demowave, local_vravatar{{/str}}</span>
                    </button>
                    <button type="button" class="local-vravatar-gbtn" data-action="demomove" title="{{#str}}demomove, local_vravatar{{/str}}" hidden>
                        <svg class="local-vravatar-icon" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg><span class="visually-hidden">{{#str}}demomove, local_vravatar{{/str}}</span>
                    </button>
                    <button type="button" class="local-vravatar-gbtn" data-action="camera" title="{{#str}}camerapreview, local_vravatar{{/str}}" aria-pressed="false" hidden>
                        <svg class="local-vravatar-icon" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg><span class="visually-hidden" data-region="cameralabel">{{#str}}camerapreview, local_vravatar{{/str}}</span>
                    </button>
                    <button type="button" class="local-vravatar-gbtn" data-action="coachagain" title="{{#str}}coach_again, local_vravatar{{/str}}" hidden>
                        <svg class="local-vravatar-icon" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3M12 17h.01"/></svg><span class="visually-hidden" data-region="coachagainlabel">{{#str}}coach_again, local_vravatar{{/str}}</span>
                    </button>
                </div>
            </div>
            <p class="small text-muted local-vravatar-previewhelp" id="local-vravatar-previewhelp" data-region="previewhelp" hidden>
                {{#str}}previewhelp, local_vravatar{{/str}}
            </p>
            <p class="small mb-0">
                <button type="button" class="btn btn-link btn-sm p-0 local-vravatar-reset" data-action="reset" hidden>
                    {{#str}}reset, local_vravatar{{/str}}
                </button>
            </p>
        </div>

        <div class="local-vravatar-choices">
            <form method="post" action="{{actionurl}}" data-region="form">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="action" value="save">
                <div class="local-vravatar-tablist" role="tablist" aria-label="{{#str}}tabs, local_vravatar{{/str}}"
                    data-region="tablist" hidden>
                    {{#haspresets}}
                        <button type="button" class="local-vravatar-tab" role="tab" id="local-vravatar-section-looks-tab"
                            aria-controls="local-vravatar-section-looks" aria-selected="true" tabindex="0" data-frame="whole">
                            <span class="local-vravatar-tabicon" style="mask-image: url({{looksicon}}); -webkit-mask-image: url({{looksicon}});"
                                aria-hidden="true"></span>
                            <span class="local-vravatar-tablabel">{{#str}}tab_looks, local_vravatar{{/str}}</span>
                        </button>
                    {{/haspresets}}
                    {{#sections}}
                        <button type="button" class="local-vravatar-tab" role="tab" id="{{tabid}}" aria-controls="{{id}}"
                            aria-selected="false" tabindex="-1" data-frame="{{frame}}">
                            <span class="local-vravatar-tabicon" style="mask-image: url({{icon}}); -webkit-mask-image: url({{icon}});"
                                aria-hidden="true"></span>
                            <span class="local-vravatar-tablabel">{{tablabel}}</span>
                        </button>
                    {{/sections}}
                </div>
                {{#haspresets}}
                    <section class="local-vravatar-section local-vravatar-looks" id="local-vravatar-section-looks"
                        aria-labelledby="local-vravatar-looks-heading" data-region="looks" hidden>
                        <h3 class="h5" id="local-vravatar-looks-heading">{{#str}}looks_heading, local_vravatar{{/str}}</h3>
                        <p class="small text-muted local-vravatar-lookshelp" id="local-vravatar-presets-help">{{#str}}presets_help, local_vravatar{{/str}}</p>
                        <div class="local-vravatar-lookgrid">
                            {{#presets}}
                                <button type="button" class="local-vravatar-look" data-action="preset" data-preset="{{id}}"
                                    data-design="{{json}}" aria-describedby="local-vravatar-presets-help">
                                    <span class="local-vravatar-pic" data-region="presetpic" aria-hidden="true"></span>
                                    <span class="local-vravatar-tile-name">{{name}}</span>
                                </button>
                            {{/presets}}
                            <button type="button" class="local-vravatar-look local-vravatar-look-surprise" data-action="surprise">
                                <span class="local-vravatar-pic" aria-hidden="true"><span class="local-vravatar-dice"></span></span>
                                <span class="local-vravatar-tile-name">{{#str}}surprise, local_vravatar{{/str}}</span>
                            </button>
                        </div>
                    </section>
                {{/haspresets}}
                {{#sections}}
                    <section class="local-vravatar-section" id="{{id}}" aria-labelledby="{{id}}-heading" data-region="panel"
                        data-tab="{{tabid}}">
                        <h3 class="h5 local-vravatar-section-heading" id="{{id}}-heading">{{heading}}</h3>
                        {{#ishands}}
                            <p class="form-text text-muted">{{#str}}hands_help, local_vravatar{{/str}}</p>
                        {{/ishands}}
                        {{#parts}}
                            <div class="local-vravatar-part" id="{{id}}" data-region="part"{{#label}} role="group" aria-labelledby="{{id}}-label"{{/label}}>
                                {{#label}}<h4 class="h6 local-vravatar-partlabel" id="{{id}}-label">{{label}}</h4>{{/label}}
                                {{#help}}<p class="local-vravatar-parthelp small text-muted">{{help}}</p>{{/help}}
                            {{#items}}
                                {{#radio}}
                                    <fieldset class="local-vravatar-group" id="{{id}}">
                                        <legend class="visually-hidden">{{legend}}</legend>
                                        <div class="local-vravatar-grouphead" aria-hidden="true">
                                            {{legend}}{{#isswatch}}<span class="local-vravatar-chosen" data-region="chosen"></span>{{/isswatch}}
                                        </div>
                                        {{#groups}}
                                            <div class="local-vravatar-subgroup"{{#legend}} role="group" aria-labelledby="{{id}}-label"{{/legend}}>
                                                {{#legend}}<div class="local-vravatar-sublegend" id="{{id}}-label">{{legend}}</div>{{/legend}}
                                                {{#help}}<p class="local-vravatar-subhelp small text-muted">{{help}}</p>{{/help}}
                                                <div class="local-vravatar-tiles{{#isswatch}} local-vravatar-swatchgrid{{/isswatch}}">
                                                    {{#options}}
                                                        <div class="local-vravatar-tile{{#isswatch}} local-vravatar-tile-swatch{{/isswatch}}">
                                                            <input class="local-vravatar-tile-input" type="radio" name="{{name}}" value="{{value}}" id="{{id}}"
                                                                {{#model}}data-model="{{model}}"{{/model}} {{#checked}}checked{{/checked}}>
                                                            <label class="local-vravatar-tile-label" for="{{id}}"{{#isswatch}} title="{{label}}"{{/isswatch}}>
                                                                {{#isswatch}}
                                                                    <span class="local-vravatar-swatch{{#follows}} local-vravatar-swatch-follows{{/follows}}"
                                                                        data-swatch="{{value}}" data-palette="{{palette}}"{{#followed}} data-follows="{{followed}}"{{/followed}}
                                                                        {{#swatch}}style="background: {{swatch}};"{{/swatch}} aria-hidden="true"></span>
                                                                {{/isswatch}}
                                                                {{^isswatch}}
                                                                    <span class="local-vravatar-pic" aria-hidden="true"
                                                                        {{#render}}data-render="{{render}}" data-key="{{name}}" data-value="{{value}}"{{/render}}>
                                                                        {{#pic}}<img src="{{pic}}" alt="" width="96" height="96" loading="lazy">{{/pic}}
                                                                        {{#mask}}<span class="local-vravatar-handpic" data-region="handpic"
                                                                            style="mask-image: url({{mask}}); -webkit-mask-image: url({{mask}});"></span>{{/mask}}
                                                                    </span>
                                                                {{/isswatch}}
                                                                <span class="local-vravatar-tile-name">{{label}}</span>
                                                                {{^isswatch}}{{#credit}}<span class="local-vravatar-credit">{{credit}}</span>{{/credit}}{{/isswatch}}
                                                            </label>
                                                        </div>
                                                    {{/options}}
                                                </div>
                                            </div>
                                        {{/groups}}
                                    </fieldset>
                                {{/radio}}
                                {{#costume}}
                                    <fieldset class="local-vravatar-group local-vravatar-costumes" id="{{id}}"
                                        aria-describedby="local-vravatar-outfit-help">
                                        <legend class="h6">{{legend}}</legend>
                                        <p class="form-text text-muted" id="local-vravatar-outfit-help">{{#str}}outfit_help, local_vravatar{{/str}}</p>
                                        {{#none}}
                                            <div class="local-vravatar-tiles local-vravatar-costumenone">
                                                <div class="local-vravatar-tile">
                                                    <input class="local-vravatar-tile-input" type="radio" name="{{name}}" value="{{value}}"
                                                        id="{{id}}" {{#checked}}checked{{/checked}}>
                                                    <label class="local-vravatar-tile-label" for="{{id}}">
                                                        <span class="local-vravatar-pic" aria-hidden="true" data-render="whole" data-key="outfit"
                                                            data-value="none"></span>
                                                        <span class="local-vravatar-tile-name">{{label}}</span>
                                                    </label>
                                                </div>
                                            </div>
                                        {{/none}}
                                        {{#categories}}
                                            <fieldset class="local-vravatar-costumecategory" id="{{id}}">
                                                <legend class="local-vravatar-costumelegend">{{legend}}</legend>
                                                <div class="local-vravatar-costumegrid">
                                                    {{#options}}
                                                        <div class="local-vravatar-tile local-vravatar-costume">
                                                            <input class="local-vravatar-tile-input" type="radio" name="outfit"
                                                                value="{{value}}" id="{{id}}"{{#model}} data-model="{{model}}"{{/model}} data-kind="{{kind}}"
                                                                {{#checked}}checked{{/checked}}>
                                                            <label class="local-vravatar-tile-label" for="{{id}}">
                                                                {{#thumb}}<img class="local-vravatar-costume-thumb" src="{{thumb}}" alt="" width="96" height="96"
                                                                    loading="lazy">{{/thumb}}
                                                                {{^thumb}}<span class="local-vravatar-pic" aria-hidden="true" data-render="{{render}}" data-key="outfit"
                                                                    data-value="{{value}}"></span>{{/thumb}}
                                                                <span class="local-vravatar-tile-name">{{label}}</span>
                                                                {{#credit}}<span class="local-vravatar-credit">{{credit}}</span>{{/credit}}
                                                            </label>
                                                        </div>
                                                    {{/options}}
                                                </div>
                                            </fieldset>
                                        {{/categories}}
                                    </fieldset>
                                    {{#hascredits}}
                                        <details class="local-vravatar-credits">
                                            <summary>{{#str}}costumecredits, local_vravatar{{/str}}</summary>
                                            <ul class="small">
                                                {{#credits}}
                                                    <li>{{name}}: <a href="{{source}}">{{title}}</a> {{credit}}</li>
                                                {{/credits}}
                                            </ul>
                                        </details>
                                    {{/hascredits}}
                                {{/costume}}
                                {{#check}}
                                    <fieldset class="local-vravatar-group" id="{{groupid}}">
                                        <legend class="visually-hidden">{{legend}}</legend>
                                        <div class="local-vravatar-grouphead" aria-hidden="true">{{legend}}</div>
                                        <div class="local-vravatar-tiles">
                                            <div class="local-vravatar-tile">
                                                <input class="local-vravatar-tile-input" type="checkbox" name="{{name}}" value="1" id="{{id}}"
                                                    {{#checked}}checked{{/checked}}>
                                                <label class="local-vravatar-tile-label" for="{{id}}">
                                                    <span class="local-vravatar-pic" aria-hidden="true"
                                                        {{#render}}data-render="{{render}}" data-key="{{name}}" data-value="1"{{/render}}></span>
                                                    <span class="local-vravatar-tile-name">{{label}}</span>
                                                </label>
                                            </div>
                                        </div>
                                    </fieldset>
                                {{/check}}
                            {{/items}}
                            </div>
                        {{/parts}}
                        {{#isextras}}
                            <fieldset class="local-vravatar-group" id="local-vravatar-group-picture">
                                <legend class="h6">{{#str}}picturebadge, local_vravatar{{/str}}</legend>
                                {{#pictureallowed}}
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="picture" value="1" id="local-vravatar-picture"
                                            aria-describedby="local-vravatar-picture-help" {{#picture}}checked{{/picture}}>
                                        <label class="form-check-label" for="local-vravatar-picture">{{#str}}picture, local_vravatar{{/str}}</label>
                                        <div class="form-text text-muted" id="local-vravatar-picture-help">
                                            {{#str}}picture_help, local_vravatar{{/str}}
                                            {{^haspicture}}{{#str}}picturenone, local_vravatar{{/str}}{{/haspicture}}
                                        </div>
                                    </div>
                                {{/pictureallowed}}
                                {{^pictureallowed}}
                                    <p class="text-muted mb-0">{{#str}}picturedisabled, local_vravatar{{/str}}</p>
                                {{/pictureallowed}}
                            </fieldset>
                        {{/isextras}}
                    </section>
                {{/sections}}

                <div class="local-vravatar-savebar" data-region="savebar">
                    <button type="submit" class="btn btn-primary" data-action="save">{{#str}}save, local_vravatar{{/str}}</button>
                    <span class="local-vravatar-dirty" data-region="dirty" hidden>{{#str}}unsaved, local_vravatar{{/str}}</span>
                    <p class="local-vravatar-status" data-region="status" role="status" aria-live="polite"></p>
                </div>
            </form>

            <form method="post" action="{{actionurl}}" data-region="removeform"{{^hasdesign}} hidden{{/hasdesign}}>
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="action" value="remove">
                <button type="submit" class="btn btn-link px-0">{{#str}}remove, local_vravatar{{/str}}</button>
            </form>
        </div>
    </div>
</div>
